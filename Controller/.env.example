# Copy this file to ".env" and adjust as needed.

# Where the module APIs are reachable.
LLM_URL=http://localhost:8001
TTS_URL=http://localhost:8002

# This Controller's own address.
HOST=0.0.0.0
PORT=9000

# How long (seconds) to wait on each call to Core_LLM / TTS.
HTTP_TIMEOUT=120

# Default system prompt for Core_LLM, used when a /speak call doesn't supply one.
# DEFAULT_SYSTEM_PROMPT=You are a helpful voice assistant. Answer clearly and concisely, in the same language the user spoke in.
