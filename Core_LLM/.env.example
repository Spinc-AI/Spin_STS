# Copy this file to ".env" and adjust as needed.
#
# The models are served locally via transformers (see model.py) -- no
# Ollama, no external API.

HOST=0.0.0.0
PORT=8001
ALLOWED_ORIGINS=*

# Override any Hugging Face model ID if you want a different checkpoint.
# GEMMA_E4B_MODEL_ID=google/gemma-4-E4B-it
# GEMMA_E2B_MODEL_ID=google/gemma-4-E2B-it
# GEMMA_E2B_QAT_MOBILE_MODEL_ID=google/gemma-4-E2B-it-qat-mobile-transformers

# Which registry key /chat and /chat_audio fall back to when a request
# doesn't specify "model" explicitly. See GET /models for the full list.
DEFAULT_MODEL=gemma-4-e2b-qat-mobile

# Max tokens generated per reply.
# MAX_NEW_TOKENS=2048

# "cuda" (default) pins the model to a single GPU, no CPU offload. Only
# change to "auto" if the model genuinely doesn't fit in your GPU's VRAM.
# DEVICE_MAP=cuda
