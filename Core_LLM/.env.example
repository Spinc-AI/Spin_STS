# Copy this file to ".env" and adjust as needed.
#
# The model is served locally via transformers (see model.py) -- no Ollama,
# no external API.

HOST=0.0.0.0
PORT=8001
ALLOWED_ORIGINS=*

# Override the Hugging Face model ID if you want a different checkpoint.
# GEMMA_MODEL_ID=google/gemma-4-E4B-it

# Max tokens generated per reply.
# MAX_NEW_TOKENS=2048

# "cuda" (default) pins the model to a single GPU, no CPU offload. Only
# change to "auto" if the model genuinely doesn't fit in your GPU's VRAM.
# DEVICE_MAP=cuda
